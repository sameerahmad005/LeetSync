# Database (PostgreSQL provider for production or SQLite for local dev)
DATABASE_URL="postgresql://leetsync_user:leetsync_pass@localhost:5432/leetsync?schema=public"

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Application Authentication Secret (at least 32 chars)
AUTH_SECRET="super-secret-at-least-32-characters-long-key-change-me"

# Base URL (Vercel domain or localhost)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
